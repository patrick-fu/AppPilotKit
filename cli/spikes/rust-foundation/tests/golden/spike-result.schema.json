{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpikeResult",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "outcome": {
      "$ref": "#/$defs/SpikeOutcome"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "outcome",
    "summary"
  ],
  "$defs": {
    "SpikeOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    }
  }
}
