{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apppilotkit.dev/cli/v1/artifact.schema.json",
  "title": "AppPilotKit CLI v1 Artifact descriptor",
  "type": "object",
  "required": ["id", "kind", "path", "media_type", "size_bytes", "digest", "sensitive"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^artifact_[A-Za-z0-9._~-]{1,120}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "media_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
      "maxLength": 255
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sensitive": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
