{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apppilotkit.dev/cli/v1/discovery.schema.json",
  "title": "AppPilotKit CLI v1 discovery data",
  "$defs": {
    "schemaList": {
      "type": "object",
      "required": ["schemas"],
      "properties": {
        "schemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    },
    "schemaShow": {
      "type": "object",
      "required": ["schema_id", "schema"],
      "properties": {
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "doctorReport": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/doctorCheck"
          }
        }
      },
      "additionalProperties": false
    },
    "doctorCheck": {
      "type": "object",
      "required": ["id", "status", "message"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "status": {
          "enum": ["passed", "skipped", "unavailable"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  }
}
