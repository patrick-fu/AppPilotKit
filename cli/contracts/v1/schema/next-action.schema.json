{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apppilotkit.dev/cli/v1/next-action.schema.json",
  "title": "AppPilotKit CLI v1 Next Action",
  "type": "object",
  "required": ["id", "argv", "side_effect", "retry_safety", "preconditions", "reason"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "side_effect": {
      "$ref": "https://apppilotkit.dev/cli/v1/machine-result.schema.json#/$defs/sideEffect"
    },
    "retry_safety": {
      "$ref": "https://apppilotkit.dev/cli/v1/machine-result.schema.json#/$defs/retrySafety"
    },
    "preconditions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
