{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apppilotkit.dev/transport/contracts/v1/schema/transport-evidence.schema.json",
  "title": "Real #62 retained installed-journey evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_commit", "recorded_at", "platform", "form_factor", "os_version", "host", "tool", "app", "installed", "broker", "target", "session", "concurrent_sessions", "session_isolation", "protocol", "command", "terminal", "cleanup", "secret_surface", "evidence_class"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "base_commit": { "$ref": "#/$defs/git_sha" },
    "recorded_at": { "type": "string", "maxLength": 64, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "platform": { "enum": ["ios-simulator", "android-emulator"] },
    "form_factor": { "enum": ["phone", "tablet"] },
    "os_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "host": { "$ref": "#/$defs/host" },
    "tool": { "$ref": "#/$defs/tool" },
    "app": { "$ref": "#/$defs/app" },
    "installed": { "$ref": "#/$defs/installed" },
    "broker": { "$ref": "#/$defs/broker" },
    "target": { "$ref": "#/$defs/target" },
    "session": { "$ref": "#/$defs/session" },
    "concurrent_sessions": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/session" } },
    "session_isolation": { "$ref": "#/$defs/session_isolation" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "command": { "$ref": "#/$defs/command" },
    "terminal": { "$ref": "#/$defs/terminal" },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "secret_surface": { "$ref": "#/$defs/secret_surface" },
    "evidence_class": { "const": "real_installed_smoke_host_journey" }
  },
  "allOf": [
    { "if": { "type": "object", "properties": { "platform": { "const": "ios-simulator" } }, "required": ["platform"] }, "then": { "type": "object", "properties": { "tool": { "type": "object", "properties": { "name": { "const": "simctl" } } }, "app": { "type": "object", "properties": { "artifact_encoding": { "const": "ios-app-tree-v1" } } }, "target": { "type": "object", "properties": { "transport": { "const": "ios_simulator_loopback_nk" } } } } } },
    { "if": { "type": "object", "properties": { "platform": { "const": "android-emulator" } }, "required": ["platform"] }, "then": { "type": "object", "properties": { "tool": { "type": "object", "properties": { "name": { "const": "adb" } } }, "app": { "type": "object", "properties": { "artifact_encoding": { "const": "raw-file-v1" } } }, "target": { "type": "object", "properties": { "transport": { "const": "android_emulator_adb_forward_localabstract_nk" } } } } } }
  ],
  "$defs": {
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "absolute_path": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000\\r\\n]*$" },
    "bytes": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "host": { "type": "object", "additionalProperties": false, "required": ["os", "arch"], "properties": { "os": { "type": "string", "minLength": 1, "maxLength": 64 }, "arch": { "const": "arm64" } } },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "enum": ["simctl", "adb"] }, "version": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "app": { "type": "object", "additionalProperties": false, "required": ["id", "build", "artifact_encoding", "artifact_sha256", "artifact_bytes_base64url", "release_excluded"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,253}[A-Za-z0-9]$" }, "build": { "type": "string", "minLength": 1, "maxLength": 128 }, "artifact_encoding": { "enum": ["ios-app-tree-v1", "raw-file-v1"] }, "artifact_sha256": { "$ref": "#/$defs/digest" }, "artifact_bytes_base64url": { "$ref": "#/$defs/bytes" }, "release_excluded": { "const": true } } },
    "installed_identity": { "type": "object", "additionalProperties": false, "required": ["name", "path", "version", "sha256", "bytes_base64url", "signature", "build", "arch"], "properties": { "name": { "enum": ["apppilotkit", "apppilotkit-broker", "apppilotkit-target-prepare"] }, "path": { "$ref": "#/$defs/absolute_path" }, "version": { "type": "string", "minLength": 1, "maxLength": 64 }, "sha256": { "$ref": "#/$defs/digest" }, "bytes_base64url": { "$ref": "#/$defs/bytes" }, "signature": { "enum": ["ad-hoc", "developer-id", "unsigned-local-checkpoint"] }, "build": { "type": "string", "minLength": 1, "maxLength": 128 }, "arch": { "const": "arm64" } } },
    "installed": { "type": "object", "additionalProperties": false, "required": ["prefix", "package_sha256", "executables"], "properties": { "prefix": { "$ref": "#/$defs/absolute_path" }, "package_sha256": { "$ref": "#/$defs/digest" }, "executables": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/installed_identity" }, "allOf": [
      { "contains": { "type": "object", "properties": { "name": { "const": "apppilotkit" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "apppilotkit-broker" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "apppilotkit-target-prepare" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }
    ] } } },
    "broker": { "type": "object", "additionalProperties": false, "required": ["pid", "euid", "start_mode", "runtime_dir_mode", "socket_mode", "peer_euid_verified"], "properties": { "pid": { "type": "integer", "minimum": 1 }, "euid": { "type": "integer", "minimum": 0 }, "start_mode": { "const": "on_demand_current_user" }, "runtime_dir_mode": { "const": "0700" }, "socket_mode": { "const": "0600" }, "peer_euid_verified": { "const": true } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["reference_digest", "transport", "lease_digest", "process_generation", "listener_epoch"], "properties": { "reference_digest": { "$ref": "#/$defs/digest" }, "transport": { "enum": ["ios_simulator_loopback_nk", "android_emulator_adb_forward_localabstract_nk"] }, "lease_digest": { "$ref": "#/$defs/digest" }, "process_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "listener_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } },
    "session_exchange": { "type": "object", "additionalProperties": false, "required": ["session_id_digest", "sha256"], "properties": { "session_id_digest": { "$ref": "#/$defs/digest" }, "sha256": { "$ref": "#/$defs/digest" } } },
    "session_runtime": { "type": "object", "additionalProperties": false, "required": ["session_id_digest", "instance_digest", "request_sha256", "response_sha256"], "properties": { "session_id_digest": { "$ref": "#/$defs/digest" }, "instance_digest": { "$ref": "#/$defs/digest" }, "request_sha256": { "$ref": "#/$defs/digest" }, "response_sha256": { "$ref": "#/$defs/digest" } } },
    "session": { "type": "object", "additionalProperties": false, "required": ["id_digest", "noise_handshake_hash_hex", "target_issued", "request", "response", "runtime"], "properties": { "id_digest": { "$ref": "#/$defs/digest" }, "noise_handshake_hash_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "target_issued": { "const": true }, "request": { "$ref": "#/$defs/session_exchange" }, "response": { "$ref": "#/$defs/session_exchange" }, "runtime": { "$ref": "#/$defs/session_runtime" } } },
    "session_isolation": { "type": "object", "additionalProperties": false, "required": ["fresh_handshakes", "fresh_session_ids", "close_a_b_remained_open", "idle_a_b_remained_open", "auth_a_b_remained_open", "lease_loss_staled_both"], "properties": { "fresh_handshakes": { "const": true }, "fresh_session_ids": { "const": true }, "close_a_b_remained_open": { "const": true }, "idle_a_b_remained_open": { "const": true }, "auth_a_b_remained_open": { "const": true }, "lease_loss_staled_both": { "const": true } } },
    "protocol": { "type": "object", "additionalProperties": false, "required": ["major", "minor", "capabilities", "max_request_bytes", "max_response_bytes", "max_page_items"], "properties": { "major": { "const": 1 }, "minor": { "const": 2 }, "capabilities": { "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "contains": { "const": "semantic.catalog" }, "minContains": 1, "maxContains": 1 }, "max_request_bytes": { "const": 16777216 }, "max_response_bytes": { "const": 67108864 }, "max_page_items": { "const": 10000 } } },
    "capture": { "type": "object", "additionalProperties": false, "required": ["identity", "path", "sha256", "byte_count", "bytes_base64url"], "properties": { "identity": { "type": "string", "minLength": 1, "maxLength": 256 }, "path": { "$ref": "#/$defs/absolute_path" }, "sha256": { "$ref": "#/$defs/digest" }, "byte_count": { "type": "integer", "minimum": 0 }, "bytes_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" } } },
    "build_artifact_identity": { "type": "object", "additionalProperties": false, "required": ["app_id", "build", "configuration", "artifact_encoding", "artifact_sha256"], "properties": { "app_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,253}[A-Za-z0-9]$" }, "build": { "type": "string", "minLength": 1, "maxLength": 128 }, "configuration": { "enum": ["debug_internal", "production", "release"] }, "artifact_encoding": { "enum": ["ios-app-tree-v1", "raw-file-v1"] }, "artifact_sha256": { "$ref": "#/$defs/digest" } } },
    "command": { "type": "object", "additionalProperties": false, "required": ["redacted_argv", "retained_stdout", "stdout_redactions", "stderr_sha256", "exit_status"], "properties": { "redacted_argv": { "type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [{ "type": "string", "pattern": "^/[^\\u0000\\r\\n]*/bin/apppilotkit$" }, { "const": "catalog" }, { "const": "list" }, { "const": "--target=<redacted>" }, { "const": "--output=json" }, { "const": "--non-interactive" }], "items": false }, "retained_stdout": { "$ref": "#/$defs/capture" }, "stdout_redactions": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "object", "additionalProperties": false, "required": ["json_pointer", "original_sha256"], "properties": { "json_pointer": { "const": "/next_actions/0/argv/7" }, "original_sha256": { "$ref": "#/$defs/digest" } } }, { "type": "object", "additionalProperties": false, "required": ["json_pointer", "original_sha256"], "properties": { "json_pointer": { "const": "/next_actions/0/argv/8" }, "original_sha256": { "$ref": "#/$defs/digest" } } }], "items": false }, "stderr_sha256": { "$ref": "#/$defs/digest" }, "exit_status": { "const": 0 } } },
    "next_action": { "type": "object", "additionalProperties": false, "required": ["kind", "target_reference_digest", "session_id_digest", "redacted_argv"], "properties": { "kind": { "enum": ["catalog.show", "catalog.list.continue", "catalog.list"] }, "target_reference_digest": { "$ref": "#/$defs/digest" }, "session_id_digest": { "$ref": "#/$defs/digest" }, "capability": { "const": "smoke.ready" }, "declaration_revision": { "const": 1 }, "cursor_digest": { "$ref": "#/$defs/digest" }, "redacted_argv": { "type": "array", "items": { "type": "string" } } }, "allOf": [
      { "if": { "type": "object", "properties": { "kind": { "const": "catalog.show" } }, "required": ["kind"] }, "then": { "type": "object", "properties": { "capability": {}, "declaration_revision": {}, "redacted_argv": { "type": "array", "minItems": 12, "maxItems": 12, "prefixItems": [{ "type": "string", "pattern": "^/[^\\u0000\\r\\n]*/bin/apppilotkit$" }, { "const": "catalog" }, { "const": "show" }, { "const": "--capability" }, { "const": "smoke.ready" }, { "const": "--declaration-revision" }, { "const": "1" }, { "const": "--session=<redacted>" }, { "const": "--target=<redacted>" }, { "const": "--output" }, { "const": "json" }, { "const": "--non-interactive" }], "items": false } }, "required": ["capability", "declaration_revision"] } },
      { "if": { "type": "object", "properties": { "kind": { "const": "catalog.list.continue" } }, "required": ["kind"] }, "then": { "type": "object", "properties": { "cursor_digest": {}, "redacted_argv": { "type": "array", "minItems": 10, "maxItems": 10, "prefixItems": [{ "type": "string", "pattern": "^/[^\\u0000\\r\\n]*/bin/apppilotkit$" }, { "const": "catalog" }, { "const": "list" }, { "const": "--session=<redacted>" }, { "const": "--target=<redacted>" }, { "const": "--cursor" }, { "const": "<redacted>" }, { "const": "--output" }, { "const": "json" }, { "const": "--non-interactive" }], "items": false } }, "required": ["cursor_digest"] } },
      { "if": { "type": "object", "properties": { "kind": { "const": "catalog.list" } }, "required": ["kind"] }, "then": { "type": "object", "properties": { "redacted_argv": { "type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [{ "type": "string", "pattern": "^/[^\\u0000\\r\\n]*/bin/apppilotkit$" }, { "const": "catalog" }, { "const": "list" }, { "const": "--session=<redacted>" }, { "const": "--target=<redacted>" }, { "const": "--output" }, { "const": "json" }, { "const": "--non-interactive" }], "items": false } } } }
    ] },
    "terminal": { "type": "object", "additionalProperties": false, "required": ["status", "machine_result_sha256", "catalog", "smoke_ready_declaration", "next_action", "transport_handoff"], "properties": { "status": { "const": "succeeded" }, "machine_result_sha256": { "$ref": "#/$defs/digest" }, "catalog": { "type": "object", "additionalProperties": false, "required": ["id", "generation"], "properties": { "id": { "type": "string", "pattern": "^catalog_[A-Za-z0-9._~-]{8,120}$" }, "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } }, "smoke_ready_declaration": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "declaration_revision"], "properties": { "id": { "const": "smoke.ready" }, "kind": { "const": "resource" }, "declaration_revision": { "const": 1 } } }, "next_action": { "$ref": "#/$defs/next_action" }, "transport_handoff": { "const": "handoff_possible_or_confirmed" } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["status", "owned_resources_remaining", "duration_ms"], "properties": { "status": { "const": "complete" }, "owned_resources_remaining": { "const": 0 }, "duration_ms": { "type": "integer", "minimum": 0, "maximum": 2000 } } },
    "scan_surface": { "type": "object", "additionalProperties": false, "required": ["name", "scanner", "scanner_version", "operation", "capture", "fixed_canary_match_count", "execution_canary_match_count", "complete"], "properties": { "name": { "enum": ["argv", "environment", "activity_extras", "stdout", "stderr", "product_logs", "diagnostics", "machine_result", "next_actions", "artifacts", "smoke_host_build_artifact", "production_build_artifact", "release_build_artifact"] }, "scanner": { "const": "apppilotkit-reference-byte-scanner" }, "scanner_version": { "const": "1.0" }, "operation": { "const": "literal-byte-subsequence-count" }, "capture": { "$ref": "#/$defs/capture" }, "artifact_identity": { "$ref": "#/$defs/build_artifact_identity" }, "fixed_canary_match_count": { "const": 0 }, "execution_canary_match_count": { "const": 0 }, "complete": { "const": true } }, "allOf": [
      { "if": { "properties": { "name": { "enum": ["smoke_host_build_artifact", "production_build_artifact", "release_build_artifact"] } }, "required": ["name"] }, "then": { "properties": { "artifact_identity": {} }, "required": ["artifact_identity"] }, "else": { "not": { "required": ["artifact_identity"] } } },
      { "if": { "properties": { "name": { "const": "smoke_host_build_artifact" } }, "required": ["name"] }, "then": { "properties": { "artifact_identity": { "type": "object", "properties": { "configuration": { "const": "debug_internal" } } } } } },
      { "if": { "properties": { "name": { "const": "production_build_artifact" } }, "required": ["name"] }, "then": { "properties": { "artifact_identity": { "type": "object", "properties": { "configuration": { "const": "production" } } } } } },
      { "if": { "properties": { "name": { "const": "release_build_artifact" } }, "required": ["name"] }, "then": { "properties": { "artifact_identity": { "type": "object", "properties": { "configuration": { "const": "release" } } } } } }
    ] },
    "secret_surface": { "type": "object", "additionalProperties": false, "required": ["fixed_canary_digest", "fixed_canary_base64url", "execution_canary_digest", "execution_canary_base64url", "surfaces", "complete"], "properties": { "fixed_canary_digest": { "$ref": "#/$defs/digest" }, "fixed_canary_base64url": { "$ref": "#/$defs/bytes" }, "execution_canary_digest": { "$ref": "#/$defs/digest" }, "execution_canary_base64url": { "$ref": "#/$defs/bytes" }, "surfaces": { "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": { "$ref": "#/$defs/scan_surface" }, "allOf": [
      { "contains": { "type": "object", "properties": { "name": { "const": "argv" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "environment" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "activity_extras" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "stdout" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "stderr" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "product_logs" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "diagnostics" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "machine_result" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "next_actions" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "artifacts" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "smoke_host_build_artifact" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "production_build_artifact" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }, { "contains": { "type": "object", "properties": { "name": { "const": "release_build_artifact" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }
    ] }, "complete": { "const": true } } }
  }
}
