{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apppilotkit.dev/transport/contracts/v1/schema/broker-control.schema.json",
  "title": "Private Broker control request and result diagnostic form",
  "description": "JSON diagnostic form of the deterministic-CBOR IPC contract. Byte strings use unpadded base64url. Secret fields are structurally absent.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$", "minLength": 22, "maxLength": 22 },
    "target_reference": { "type": "string", "pattern": "^target_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$", "minLength": 50, "maxLength": 50 },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{16,128}$", "minLength": 16, "maxLength": 128 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71 },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "deadline_unix_ms", "operation", "body"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "deadline_unix_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "operation": { "enum": ["prepare", "open_session", "exchange", "close_session", "close_lease"] },
        "body": {
          "oneOf": [
            { "$ref": "#/$defs/prepare_body" },
            { "$ref": "#/$defs/open_body" },
            { "$ref": "#/$defs/exchange_body" },
            { "$ref": "#/$defs/close_session_body" },
            { "$ref": "#/$defs/close_lease_body" }
          ]
        }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "prepare" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/prepare_body" } } } },
        { "if": { "properties": { "operation": { "const": "open_session" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/open_body" } } } },
        { "if": { "properties": { "operation": { "const": "exchange" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/exchange_body" } } } },
        { "if": { "properties": { "operation": { "const": "close_session" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/close_session_body" } } } },
        { "if": { "properties": { "operation": { "const": "close_lease" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/close_lease_body" } } } }
      ]
    },
    "prepare_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "device_selector", "app_id", "app_artifact", "artifact_encoding", "app_artifact_sha256"],
      "properties": {
        "platform": { "enum": ["ios-simulator", "android-emulator"] },
        "device_selector": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$" },
        "app_id": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,253}[A-Za-z0-9]$" },
        "app_artifact": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000\\r\\n]*$", "description": "Unicode path; the semantic validator separately enforces UTF8(value).len <= 4096." },
        "artifact_encoding": { "enum": ["ios-app-tree-v1", "raw-file-v1"] },
        "app_artifact_sha256": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        { "if": { "properties": { "platform": { "const": "ios-simulator" } }, "required": ["platform"] }, "then": { "properties": { "artifact_encoding": { "const": "ios-app-tree-v1" } } } },
        { "if": { "properties": { "platform": { "const": "android-emulator" } }, "required": ["platform"] }, "then": { "properties": { "artifact_encoding": { "const": "raw-file-v1" } } } }
      ]
    },
    "open_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "required_capabilities"],
      "properties": {
        "target": { "$ref": "#/$defs/target_reference" },
        "session": { "$ref": "#/$defs/session_id" },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]+(?:\\.[a-z][a-z0-9]+)+$", "minLength": 3, "maxLength": 128 }
        },
        "session_open_request_base64url": { "$ref": "#/$defs/session_open_message" },
        "session_open_request_sha256": { "$ref": "#/$defs/digest" }
      },
      "oneOf": [
        { "properties": { "target": {}, "session": {}, "required_capabilities": {}, "session_open_request_base64url": {}, "session_open_request_sha256": {} }, "required": ["target", "session", "required_capabilities"], "not": { "anyOf": [{ "properties": { "session_open_request_base64url": {} }, "required": ["session_open_request_base64url"] }, { "properties": { "session_open_request_sha256": {} }, "required": ["session_open_request_sha256"] }] } },
        { "properties": { "target": {}, "session": {}, "required_capabilities": {}, "session_open_request_base64url": {}, "session_open_request_sha256": {} }, "required": ["target", "required_capabilities", "session_open_request_base64url", "session_open_request_sha256"], "not": { "properties": { "session": {} }, "required": ["session"] } }
      ]
    },
    "exchange_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "session", "process_generation", "listener_epoch", "message_base64url", "message_sha256", "side_effect"],
      "properties": {
        "target": { "$ref": "#/$defs/target_reference" },
        "session": { "$ref": "#/$defs/session_id" },
        "process_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "listener_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "message_base64url": { "type": "string", "minLength": 2, "maxLength": 22369622, "pattern": "^(?:(?:[A-Za-z0-9_-]{4})+|(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-][AQgw]|(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])$" },
        "message_sha256": { "$ref": "#/$defs/digest" },
        "side_effect": { "enum": ["read_only", "local_write", "app_mutation", "device_mutation"] }
      }
    },
    "close_session_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "session", "process_generation", "listener_epoch", "reason"],
      "properties": {
        "target": { "$ref": "#/$defs/target_reference" },
        "session": { "$ref": "#/$defs/session_id" },
        "process_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "listener_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "reason": { "$ref": "#/$defs/close_reason" }
      }
    },
    "close_lease_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reason"],
      "properties": {
        "target": { "$ref": "#/$defs/target_reference" },
        "reason": { "$ref": "#/$defs/close_reason" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "status", "result"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "status": { "const": "succeeded" },
        "result": { "$ref": "#/$defs/result_body" }
      }
    },
    "result_body": {
      "oneOf": [
        { "$ref": "#/$defs/target_ready_result" },
        { "$ref": "#/$defs/session_opened_result" },
        { "$ref": "#/$defs/exchange_complete_result" },
        { "$ref": "#/$defs/closed_result" }
      ]
    },
    "target_ready_result": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "process_generation", "listener_epoch", "issued_at_unix_ms", "expires_at_unix_ms"],
      "properties": {
        "kind": { "const": "target_ready" },
        "target": { "$ref": "#/$defs/target_reference" },
        "process_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "listener_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "issued_at_unix_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "expires_at_unix_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "session_opened_result": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "session_open_response_base64url", "session_open_response_sha256", "process_generation", "listener_epoch", "handoff"],
      "properties": {
        "kind": { "const": "session_opened" },
        "target": { "$ref": "#/$defs/target_reference" },
        "session_open_response_base64url": { "$ref": "#/$defs/session_open_message" },
        "session_open_response_sha256": { "$ref": "#/$defs/digest" },
        "process_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "listener_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "handoff": { "enum": ["not_handed_off", "handoff_possible_or_confirmed"] }
      }
    },
    "exchange_complete_result": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "session", "process_generation", "listener_epoch", "message_base64url", "message_sha256", "handoff"],
      "properties": {
        "kind": { "const": "exchange_complete" },
        "target": { "$ref": "#/$defs/target_reference" },
        "session": { "$ref": "#/$defs/session_id" },
        "process_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "listener_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "message_base64url": { "type": "string", "minLength": 2, "maxLength": 89478486, "pattern": "^(?:(?:[A-Za-z0-9_-]{4})+|(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-][AQgw]|(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])$" },
        "message_sha256": { "$ref": "#/$defs/digest" },
        "handoff": { "enum": ["not_handed_off", "handoff_possible_or_confirmed"] }
      }
    },
    "closed_result": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "handoff"],
      "properties": {
        "kind": { "const": "closed" },
        "target": { "$ref": "#/$defs/target_reference" },
        "session": { "$ref": "#/$defs/session_id" },
        "handoff": { "enum": ["not_handed_off", "handoff_possible_or_confirmed"] }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "status", "error"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "status": { "const": "failed" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message", "retryable", "stage", "handoff", "close_reason"],
          "properties": {
            "kind": { "enum": ["target.selectionRequired", "sessionExpired", "transport.authenticationRequired", "timeout", "internalError"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]*$" },
            "retryable": { "type": "boolean" },
            "stage": { "enum": ["ipc", "prepare", "bootstrap", "session_handshake", "session_open", "exchange", "close", "cleanup"] },
            "handoff": { "enum": ["not_handed_off", "handoff_possible_or_confirmed"] },
            "close_reason": { "$ref": "#/$defs/close_reason" }
          }
        }
      }
    },
    "close_reason": {
      "enum": ["normal", "authenticationFailed", "bindingMismatch", "stale", "timeout", "oversize", "malformed", "sequenceViolation", "recordLimit", "peerClosed", "brokerLost", "eligibilityLost", "cleanupFailed", "internalError"]
    },
    "session_open_message": { "type": "string", "minLength": 2, "maxLength": 87382, "pattern": "^(?:(?:[A-Za-z0-9_-]{4})+|(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-][AQgw]|(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])$" }
  }
}
