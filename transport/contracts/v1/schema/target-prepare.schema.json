{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apppilotkit.dev/transport/contracts/v1/schema/target-prepare.schema.json",
  "title": "Setup-only launch-or-reuse-owned-lease target prepare stdin and result",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "platform", "device_selector", "app_id", "app_artifact", "artifact_encoding"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "platform": { "enum": ["ios-simulator", "android-emulator"] },
        "device_selector": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$" },
        "app_id": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,253}[A-Za-z0-9]$" },
        "app_artifact": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000\\r\\n]*$", "description": "Unicode path; the semantic validator separately enforces UTF8(value).len <= 4096." },
        "artifact_encoding": { "enum": ["ios-app-tree-v1", "raw-file-v1"] }
      },
      "allOf": [
        { "if": { "properties": { "platform": { "const": "ios-simulator" } }, "required": ["platform"] }, "then": { "properties": { "artifact_encoding": { "const": "ios-app-tree-v1" } } } },
        { "if": { "properties": { "platform": { "const": "android-emulator" } }, "required": ["platform"] }, "then": { "properties": { "artifact_encoding": { "const": "raw-file-v1" } } } }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "ready_target"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "status": { "const": "succeeded" },
        "ready_target": { "$ref": "target-ready.schema.json" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "status": { "enum": ["failed", "cancelled"] },
        "error": { "$ref": "#/$defs/safe_error" }
      }
    },
    "safe_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "retryable", "stage"],
      "properties": {
        "kind": {
          "enum": [
            "cli.invalidInvocation",
            "target.selectionRequired",
            "sessionExpired",
            "transport.authenticationRequired",
            "timeout",
            "internalError",
            "run.cancelled"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]*$" },
        "retryable": { "type": "boolean" },
        "stage": { "enum": ["input", "broker", "launch", "listener", "bootstrap", "cleanup"] }
      }
    }
  }
}
